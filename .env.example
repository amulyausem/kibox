# Get a key at https://aistudio.google.com/apikey
# Restart Expo after changing this file.
EXPO_PUBLIC_GEMINI_API_KEY=

# Optional: keep the Gemini key off-device.
# GEMINI_API_KEY=  (used by `npm run proxy`)
# EXPO_PUBLIC_VISION_PROXY_URL=http://192.168.1.10:8787
# Same host is used for household sync unless you set:
# EXPO_PUBLIC_SYNC_URL=http://192.168.1.10:8787

# Instacart Developer Platform — real shopping-list page.
# INSTACART_API_KEY=  (proxy)
# EXPO_PUBLIC_INSTACART_API_KEY=

# Or use OpenAI instead (key starts with sk-)
# EXPO_PUBLIC_OPENAI_API_KEY=
